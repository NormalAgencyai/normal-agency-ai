<style>
.pv-wrap{max-width:860px;margin:0 auto;padding:110px 18px 50px;position:relative}
.pv-head{text-align:center;margin-bottom:28px}
.pv-head .section-title{margin:10px 0 8px}
.pv-head p{color:var(--text-muted);margin:0;font-size:15px}
.pv-lang{display:flex;justify-content:center;gap:8px;margin:22px 0 4px;flex-wrap:wrap}
.pv-lang button{font-family:'Cairo',sans-serif;font-weight:700;font-size:14px;padding:9px 20px;border-radius:999px;border:1px solid var(--border-color);background:var(--card-bg);color:var(--text-main);cursor:pointer;transition:.2s}
.pv-lang button:hover{border-color:var(--normal-blue);color:var(--normal-blue)}
.pv-lang button.on{background:linear-gradient(135deg,#2B8FE0,#1E78BD);color:#fff;border-color:transparent}
.pv-card{background:var(--card-bg);border:1px solid var(--border-color);border-radius:22px;padding:28px 26px;box-shadow:var(--shadow-premium)}
.pv-card h2{font-size:17px;color:var(--normal-blue);margin:22px 0 6px;font-weight:800}
.pv-card h2:first-child{margin-top:0}
.pv-card p{color:var(--text-muted);line-height:2;margin:0;font-size:15px}
.pv-card a{color:var(--normal-blue)}
.pv-date{display:inline-block;margin-top:22px;font-size:13px;color:var(--text-muted);border:1px solid var(--border-color);border-radius:999px;padding:5px 14px}
.pv-back{display:inline-flex;align-items:center;gap:6px;margin-top:22px;font-weight:700;text-decoration:none;color:var(--normal-blue)}
.pv-cta{text-align:center;margin-top:26px}.pv-cta a{display:inline-block}body{padding-bottom:0}
.pv-l{display:none}.pv-l.show{display:block}
[dir="ltr"] .pv-card{text-align:left}
@media(max-width:600px){.pv-wrap{padding-top:96px}.pv-card{padding:22px 18px}}
