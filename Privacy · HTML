</nav>

<main class="pv-wrap">
    <div class="pv-head">
        <span class="section-tag" data-ar="الخصوصية" data-en="PRIVACY" data-fr="CONFIDENTIALITÉ">الخصوصية</span>
        <h1 class="section-title" data-ar="سياسة الخصوصية" data-en="Privacy Policy" data-fr="Politique de confidentialité">سياسة الخصوصية</h1>
        <p data-ar="وكالة نورمال للخدمات التسويقية" data-en="Normal Marketing Services Agency" data-fr="Agence Normal de services marketing">وكالة نورمال للخدمات التسويقية</p>
        <div class="pv-lang">
