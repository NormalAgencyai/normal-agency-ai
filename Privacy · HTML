        <div class="footer-bottom"><span id="y"></span> © NORMAL AGENCY — <span data-ar="جميع الحقوق محفوظة" data-en="All rights reserved" data-fr="Tous droits réservés">جميع الحقوق محفوظة</span></div>
    </div>
</footer>

<script>
function toggleTheme(){var n=document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark';document.documentElement.setAttribute('data-theme',n);try{localStorage.setItem('theme',n)}catch(e){}}
function setL(l){
  var h=document.documentElement;h.lang=l;h.dir=l==='ar'?'rtl':'ltr';
  document.querySelectorAll('.pv-l').forEach(function(s){s.classList.toggle('show',s.dataset.l===l)});
  document.querySelectorAll('.pv-lang button').forEach(function(b){b.classList.toggle('on',b.dataset.l===l)});
  document.querySelectorAll('[data-ar]').forEach(function(e){var v=e.getAttribute('data-'+l);if(v)e.textContent=v});
  document.title=({ar:'سياسة الخصوصية',en:'Privacy Policy',fr:'Politique de confidentialité'})[l]+' | Normal Agency';
  try{localStorage.setItem('plang',l)}catch(e){}
}
document.getElementById('y').textContent=new Date().getFullYear();
(function(){var l='ar';try{l=localStorage.getItem('plang')||'ar'}catch(e){}if(l!=='ar')setL(l)})();
</script>
</body>
</html>
